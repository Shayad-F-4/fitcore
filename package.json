{
  "name": "fitcore",
  "version": "1.0.0",
  "description": "FitCore - Sagar Fitness Gym Management System",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix server",
    "dev": "npm run dev --prefix server",
    "build": "npm run build --prefix server && node scripts/copy-frontend.js",
    "build:server": "npm run build --prefix server",
    "backup": "powershell -ExecutionPolicy Bypass -File ./scripts/backup.ps1",
    "seed": "npm run seed --prefix server",
    "test": "npm run test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
