# ==============================================================================
# SAGAR FITNESS GYM - CLIENT ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# In local development with Vite dev server, requests to /api are proxied to http://localhost:5000.
# In production, set VITE_API_URL if the backend API is hosted on a separate domain.
# Example: VITE_API_URL=https://api.sagarfitness.com/api

VITE_API_URL=/api
