<%- include('partials/header', { title: 'Membership Plans' }) %>

<div class="flex h-screen overflow-hidden">
  <%- include('partials/sidebar', { activePage: 'plans' }) %>

  <div class="flex-1 flex flex-col min-w-0 bg-[#F7F8FA] h-screen overflow-y-auto">
    <%- include('partials/navbar', { pageTitle: 'Membership Plans' }) %>

    <main class="flex-1 p-4 sm:p-6 md:p-8 max-w-7xl w-full mx-auto pb-24 lg:pb-12 space-y-4">
      
      <!-- Top Action -->
      <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-slate-900">Gym Membership Tariffs</h2>
          <p class="text-[11px] text-slate-400">Configure prices, duration, and admission schemes</p>
        </div>
        <button type="button" onclick="openPlanModal()" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs rounded-xl shadow-xs transition-all">
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          <span>Create Plan</span>
        </button>
      </div>

      <!-- Plans Grid -->
      <div id="plans-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="col-span-full py-12 text-center text-slate-400">Loading plans...</div>
      </div>

    </main>
  </div>
</div>

<%- include('partials/mobileNav', { activePage: 'plans' }) %>

<!-- Create / Edit Plan Modal -->
<div id="plan-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl p-6 space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <h3 class="text-base font-bold text-slate-900" id="plan-modal-title">New Membership Plan</h3>
      <button type="button" onclick="closePlanModal()" class="p-1 rounded-lg text-slate-400 hover:bg-slate-100">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form id="plan-form" class="space-y-3.5">
      <input type="hidden" id="plan-id">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Plan Name *</label>
        <input type="text" id="plan-name" required placeholder="e.g. 1 Month Regular or Annual Gold" class="w-full h-10 px-3 text-xs border border-slate-300 rounded-xl focus:border-purple-600 focus:outline-none font-medium">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Duration (Days) *</label>
          <input type="number" id="plan-days" required min="1" placeholder="e.g. 30" class="w-full h-10 px-3 text-xs border border-slate-300 rounded-xl focus:border-purple-600 focus:outline-none font-medium">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Fee Amount (₹) *</label>
          <input type="number" id="plan-price" required min="0" placeholder="e.g. 1500" class="w-full h-10 px-3 text-xs border border-slate-300 rounded-xl focus:border-purple-600 focus:outline-none font-medium">
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Description (Optional)</label>
        <textarea id="plan-desc" rows="2" placeholder="Plan highlights, cardio, trainer included..." class="w-full p-2.5 text-xs border border-slate-300 rounded-xl focus:border-purple-600 focus:outline-none font-medium"></textarea>
      </div>

      <div class="pt-2">
        <button type="submit" id="plan-submit-btn" class="w-full h-11 bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs rounded-xl shadow-md transition-all">
          Save Plan
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>

<script>
  function openPlanModal(plan = null) {
    const modal = document.getElementById('plan-modal');
    const form = document.getElementById('plan-form');
    form.reset();

    if (plan) {
      document.getElementById('plan-modal-title').textContent = 'Edit Membership Plan';
      document.getElementById('plan-id').value = plan._id;
      document.getElementById('plan-name').value = plan.name;
      document.getElementById('plan-days').value = plan.durationDays;
      document.getElementById('plan-price').value = plan.price;
      document.getElementById('plan-desc').value = plan.description || '';
    } else {
      document.getElementById('plan-modal-title').textContent = 'New Membership Plan';
      document.getElementById('plan-id').value = '';
    }

    modal.classList.remove('hidden');
  }

  function closePlanModal() {
    document.getElementById('plan-modal').classList.add('hidden');
  }

  async function loadPlans() {
    try {
      const plans = await api.get('/plans');
      const grid = document.getElementById('plans-grid');
      const items = Array.isArray(plans) ? plans : (plans.data || []);

      if (items.length === 0) {
        grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400">No membership plans created yet.</div>`;
        return;
      }

      grid.innerHTML = items.map(p => `
        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs flex flex-col justify-between hover:shadow-md transition-all">
          <div>
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-100">
                ${p.durationDays} Days
              </span>
              <button onclick='deletePlan("${p._id}")' class="text-slate-300 hover:text-rose-600 p-1 rounded-lg transition-colors">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
            <h3 class="text-base font-bold text-slate-900 mt-3">${p.name}</h3>
            <p class="text-xs text-slate-500 mt-1 line-clamp-2">${p.description || 'Full gym facility access & training.'}</p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[10px] text-slate-400 uppercase font-bold">Standard Fee</span>
              <div class="text-xl font-black text-slate-900">${formatINR(p.price)}</div>
            </div>
            <button onclick='openPlanModal(${JSON.stringify(p)})' class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-lg transition-colors">
              Edit
            </button>
          </div>
        </div>
      `).join('');

      if (window.lucide) lucide.createIcons();
    } catch (err) {
      document.getElementById('plans-grid').innerHTML = `<div class="col-span-full py-12 text-center text-rose-500">Failed to load plans.</div>`;
    }
  }

  async function deletePlan(id) {
    if (!confirm('Are you sure you want to delete this membership plan?')) return;
    try {
      await api.delete(`/plans/${id}`);
      showToast('Deleted', 'Plan removed successfully', 'success');
      loadPlans();
    } catch (err) {
      showToast('Error', err.message || 'Could not delete plan', 'error');
    }
  }

  document.getElementById('plan-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('plan-submit-btn');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    const id = document.getElementById('plan-id').value;
    const payload = {
      name: document.getElementById('plan-name').value.trim(),
      durationDays: Number(document.getElementById('plan-days').value),
      price: Number(document.getElementById('plan-price').value),
      description: document.getElementById('plan-desc').value.trim() || undefined,
    };

    try {
      if (id) {
        await api.put(`/plans/${id}`, payload);
        showToast('Updated', 'Plan updated successfully', 'success');
      } else {
        await api.post('/plans', payload);
        showToast('Created', 'New plan added successfully', 'success');
      }
      closePlanModal();
      loadPlans();
    } catch (err) {
      showToast('Error', err.message || 'Failed to save plan', 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Save Plan';
    }
  });

  document.addEventListener('DOMContentLoaded', loadPlans);
</script>
