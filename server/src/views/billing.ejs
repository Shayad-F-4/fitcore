<%- include('partials/header', { title: 'Billing & Payments' }) %>

<div class="flex h-screen overflow-hidden">
  <%- include('partials/sidebar', { activePage: 'billing' }) %>

  <div class="flex-1 flex flex-col min-w-0 bg-[#F7F8FA] h-screen overflow-y-auto">
    <%- include('partials/navbar', { pageTitle: 'Billing & Fees Management' }) %>

    <main class="flex-1 p-4 sm:p-6 md:p-8 max-w-7xl w-full mx-auto pb-24 lg:pb-12 space-y-4">
      
      <!-- Top Actions & Pending Dues Quick Collect -->
      <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/80 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-sm font-bold text-slate-900">Fee Transactions & Invoices</h2>
          <p class="text-[11px] text-slate-400">Track membership payments, partial dues, and generate official receipts</p>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" onclick="openCollectModal()" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl shadow-xs transition-all">
            <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
            <span>Record Payment / Due</span>
          </button>
        </div>
      </div>

      <!-- Payments Table -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
          <span class="text-xs font-bold text-slate-800 uppercase tracking-wider">Transaction Records</span>
          <span class="text-xs text-slate-400" id="billing-count-label">Loading transactions...</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50/80 text-slate-500 font-bold uppercase tracking-wider border-b border-slate-100">
              <tr>
                <th class="py-3 px-4">Receipt #</th>
                <th class="py-3 px-4">Member</th>
                <th class="py-3 px-4">Amount Paid</th>
                <th class="py-3 px-4">Payment Mode</th>
                <th class="py-3 px-4">Date</th>
                <th class="py-3 px-4 text-right">Receipt</th>
              </tr>
            </thead>
            <tbody id="payments-table-body" class="divide-y divide-slate-100 font-medium">
              <tr>
                <td colspan="6" class="py-8 text-center text-slate-400">Loading payment history...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>
</div>

<%- include('partials/mobileNav', { activePage: 'billing' }) %>

<!-- Record Payment Modal -->
<div id="collect-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl p-6 space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <h3 class="text-base font-bold text-slate-900">Record Fee Payment</h3>
      <button type="button" onclick="closeCollectModal()" class="p-1 rounded-lg text-slate-400 hover:bg-slate-100">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form id="collect-form" class="space-y-3.5">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Select Member *</label>
        <select id="collect-member-select" required class="w-full h-10 px-3 text-xs border border-slate-300 rounded-xl focus:border-rose-600 focus:outline-none font-medium bg-white">
          <option value="">-- Choose member --</option>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Amount Paid (₹) *</label>
          <input type="number" id="collect-amount" required min="1" placeholder="e.g. 1500" class="w-full h-10 px-3 text-xs border border-slate-300 rounded-xl focus:border-rose-600 focus:outline-none font-medium">
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Payment Method</label>
          <select id="collect-method" class="w-full h-10 px-3 text-xs border border-slate-300 rounded-xl focus:border-rose-600 focus:outline-none font-medium bg-white">
            <option value="CASH">Cash</option>
            <option value="UPI">UPI / GPay / PhonePe</option>
            <option value="CARD">Debit / Credit Card</option>
            <option value="BANK_TRANSFER">Bank Transfer</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Remarks / Reference (Optional)</label>
        <input type="text" id="collect-remarks" placeholder="UPI ref or note" class="w-full h-10 px-3 text-xs border border-slate-300 rounded-xl focus:border-rose-600 focus:outline-none font-medium">
      </div>

      <div class="pt-2">
        <button type="submit" id="collect-submit-btn" class="w-full h-11 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl shadow-md transition-all">
          Record Payment & Generate Receipt
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Receipt Printable Modal -->
<div id="receipt-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
  <div class="w-full max-w-sm bg-white rounded-2xl shadow-2xl p-6 space-y-4 font-mono select-none">
    <div class="text-center pb-3 border-b border-dashed border-slate-300">
      <h3 class="text-base font-black tracking-wider text-slate-900">SAGAR FITNESS GYM</h3>
      <p class="text-[10px] text-slate-500 font-sans">Pathardi, Maharashtra • +91 98811 22334</p>
      <div class="mt-2 text-xs font-bold text-slate-700" id="rec-number">RECEIPT #REC-0000</div>
    </div>

    <div class="space-y-2 text-xs text-slate-700">
      <div class="flex justify-between">
        <span class="text-slate-400">Date:</span>
        <span class="font-bold" id="rec-date">-</span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Member:</span>
        <span class="font-bold" id="rec-member">-</span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Payment Mode:</span>
        <span class="font-bold" id="rec-mode">CASH</span>
      </div>
      <div class="pt-2 border-t border-dashed border-slate-300 flex justify-between text-sm">
        <span class="font-bold">TOTAL PAID:</span>
        <span class="font-black text-emerald-700" id="rec-amount">₹0</span>
      </div>
    </div>

    <div class="pt-3 border-t border-slate-100 flex items-center gap-2 font-sans">
      <button type="button" onclick="window.print()" class="flex-1 py-2 bg-blue-600 text-white text-xs font-bold rounded-xl shadow-xs">
        Print Receipt
      </button>
      <button type="button" onclick="closeReceiptModal()" class="px-3 py-2 bg-slate-100 text-slate-700 text-xs font-bold rounded-xl">
        Close
      </button>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

<script>
  let paymentsList = [];

  function openCollectModal() {
    document.getElementById('collect-modal').classList.remove('hidden');
    loadMembersForBilling();
  }
  function closeCollectModal() {
    document.getElementById('collect-modal').classList.add('hidden');
  }

  function closeReceiptModal() {
    document.getElementById('receipt-modal').classList.add('hidden');
  }

  async function loadMembersForBilling() {
    try {
      const res = await api.get('/members');
      const members = Array.isArray(res) ? res : (res.data?.members || res.members || []);
      const select = document.getElementById('collect-member-select');
      select.innerHTML = '<option value="">-- Choose member --</option>' +
        members.map(m => `<option value="${m._id}">${m.fullName} (${m.phone || 'No phone'})</option>`).join('');
    } catch (err) {
      console.warn('Load members error:', err);
    }
  }

  async function loadPayments() {
    try {
      const res = await api.get('/payments');
      paymentsList = Array.isArray(res) ? res : (res.data?.payments || res.payments || []);
      const tbody = document.getElementById('payments-table-body');
      document.getElementById('billing-count-label').textContent = `${paymentsList.length} total payments`;

      if (paymentsList.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-slate-400">No payment records found.</td></tr>`;
        return;
      }

      tbody.innerHTML = paymentsList.map(p => {
        const memberName = p.member?.fullName || p.memberName || 'Member';
        const recNum = p.receiptNumber || 'REC-' + (p._id || '').slice(-6).toUpperCase();
        const dateStr = formatDateIN(p.createdAt || p.paymentDate);
        const amount = formatINR(p.amount);
        const method = p.paymentMethod || p.method || 'CASH';

        return `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="py-3 px-4 font-mono font-bold text-slate-800">${recNum}</td>
            <td class="py-3 px-4 font-bold text-slate-900">${memberName}</td>
            <td class="py-3 px-4 font-black text-emerald-700">${amount}</td>
            <td class="py-3 px-4">
              <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-700 uppercase font-mono">${method}</span>
            </td>
            <td class="py-3 px-4 text-slate-500">${dateStr}</td>
            <td class="py-3 px-4 text-right">
              <button onclick='showReceipt(${JSON.stringify(p)})' class="px-2.5 py-1 text-xs font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors">
                View Receipt
              </button>
            </td>
          </tr>
        `;
      }).join('');

      if (window.lucide) lucide.createIcons();
    } catch (err) {
      document.getElementById('payments-table-body').innerHTML = `<tr><td colspan="6" class="py-8 text-center text-rose-500">Failed to load payments.</td></tr>`;
    }
  }

  function showReceipt(p) {
    document.getElementById('rec-number').textContent = p.receiptNumber || 'RECEIPT #' + (p._id || '').slice(-6).toUpperCase();
    document.getElementById('rec-date').textContent = formatDateIN(p.createdAt || p.paymentDate);
    document.getElementById('rec-member').textContent = p.member?.fullName || p.memberName || 'Member';
    document.getElementById('rec-mode').textContent = p.paymentMethod || 'CASH';
    document.getElementById('rec-amount').textContent = formatINR(p.amount);
    document.getElementById('receipt-modal').classList.remove('hidden');
  }

  document.getElementById('collect-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('collect-submit-btn');
    btn.disabled = true;
    btn.textContent = 'Recording...';

    const memberId = document.getElementById('collect-member-select').value;
    const amount = Number(document.getElementById('collect-amount').value);
    const paymentMethod = document.getElementById('collect-method').value;
    const remarks = document.getElementById('collect-remarks').value.trim() || undefined;

    try {
      const res = await api.post('/payments', { memberId, amount, paymentMethod, remarks });
      showToast('Payment Recorded', `Payment of ${formatINR(amount)} logged successfully!`, 'success');
      closeCollectModal();
      document.getElementById('collect-form').reset();
      loadPayments();
      if (res) showReceipt(res);
    } catch (err) {
      showToast('Error', err.message || 'Could not record payment', 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Record Payment & Generate Receipt';
    }
  });

  document.addEventListener('DOMContentLoaded', loadPayments);
</script>
