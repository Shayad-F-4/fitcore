<header class="bg-white border-b border-slate-200 sticky top-0 z-20 px-4 sm:px-6 py-3.5 flex items-center justify-between">
  <!-- Mobile Menu & Page Title -->
  <div class="flex items-center gap-3">
    <button type="button" id="mobile-sidebar-toggle" class="lg:hidden p-2 rounded-xl text-slate-500 hover:bg-slate-100 transition-colors">
      <i data-lucide="menu" class="w-5 h-5"></i>
    </button>
    <div>
      <h1 class="text-base sm:text-lg font-bold text-slate-900 leading-tight">
        <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Sagar Fitness Gym' %>
      </h1>
      <p class="text-[11px] text-slate-400 font-medium hidden sm:block">Pathardi, Ahmednagar • Gym Management System</p>
    </div>
  </div>

  <!-- Right Actions -->
  <div class="flex items-center gap-2.5">
    <!-- Quick Register Member Button -->
    <button type="button" onclick="openRegisterModal()" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-3.5 py-2 rounded-xl shadow-sm transition-all active:scale-95 cursor-pointer">
      <i data-lucide="user-plus" class="w-4 h-4"></i>
      <span class="hidden sm:inline">New Admission</span>
    </button>

    <!-- Branch Pill -->
    <div class="hidden md:flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 rounded-xl text-xs font-semibold text-slate-600 border border-slate-200">
      <i data-lucide="building-2" class="w-3.5 h-3.5 text-blue-600"></i>
      <span>Sagar Fitness</span>
    </div>
  </div>
</header>
