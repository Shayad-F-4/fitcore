<header class="bg-white border-b border-slate-200/80 sticky top-0 z-20 px-4 sm:px-6 py-3 sm:py-3.5 flex items-center justify-between select-none">
  <!-- Mobile Menu & Page Title -->
  <div class="flex items-center gap-3">
    <button type="button" id="mobile-sidebar-toggle" class="lg:hidden p-2 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer" aria-label="Toggle Navigation">
      <i data-lucide="menu" class="w-5 h-5"></i>
    </button>
    <div>
      <h1 class="text-base sm:text-lg font-black text-slate-900 leading-tight tracking-tight">
        <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Sagar Fitness Gym' %>
      </h1>
      <p class="text-[11px] text-slate-400 font-medium hidden sm:block">Pathardi, Ahmednagar • Gym Management System</p>
    </div>
  </div>

  <!-- Right Actions -->
  <div class="flex items-center gap-2 sm:gap-3">
    <!-- Quick Register Member Button -->
    <button
      type="button"
      onclick="openRegisterModal()"
      class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 active:scale-95 text-white text-xs font-bold px-3.5 py-2 rounded-xl shadow-xs hover:shadow-md hover:shadow-blue-500/20 transition-all cursor-pointer"
    >
      <i data-lucide="user-plus" class="w-4 h-4"></i>
      <span class="hidden sm:inline">New Admission</span>
    </button>

    <!-- Branch Badge -->
    <div class="hidden md:flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 rounded-xl text-xs font-bold text-slate-700 border border-slate-200 shadow-2xs">
      <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
      <span>Sagar Fitness Pathardi</span>
    </div>
  </div>
</header>
