<!-- Mobile Bottom Navigation -->
<nav class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 px-3 py-1.5 flex items-center justify-around select-none">
  <a href="/" class="flex flex-col items-center justify-center py-1 px-3 rounded-xl transition-colors <%= activePage === 'dashboard' ? 'text-blue-600 font-bold bg-blue-50/80' : 'text-slate-500 hover:text-slate-900' %>">
    <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
    <span class="text-[10px] mt-0.5">Home</span>
  </a>

  <a href="/members" class="flex flex-col items-center justify-center py-1 px-3 rounded-xl transition-colors <%= activePage === 'members' ? 'text-emerald-600 font-bold bg-emerald-50/80' : 'text-slate-500 hover:text-slate-900' %>">
    <i data-lucide="users" class="w-5 h-5"></i>
    <span class="text-[10px] mt-0.5">Members</span>
  </a>

  <a href="/billing" class="flex flex-col items-center justify-center py-1 px-3 rounded-xl transition-colors <%= activePage === 'billing' ? 'text-rose-600 font-bold bg-rose-50/80' : 'text-slate-500 hover:text-slate-900' %>">
    <i data-lucide="receipt" class="w-5 h-5"></i>
    <span class="text-[10px] mt-0.5">Billing</span>
  </a>

  <button type="button" onclick="toggleMobileDrawer()" class="flex flex-col items-center justify-center py-1 px-3 rounded-xl text-slate-500 hover:text-slate-900 transition-colors">
    <i data-lucide="menu" class="w-5 h-5"></i>
    <span class="text-[10px] mt-0.5">More</span>
  </button>
</nav>

<!-- Mobile Slide-out Drawer -->
<div id="mobile-drawer" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs hidden transition-opacity">
  <div class="fixed inset-y-0 left-0 max-w-xs w-full bg-white shadow-2xl p-5 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-slate-100">
        <img src="/logo.png" alt="Sagar Fitness" class="h-8 w-auto">
        <button type="button" onclick="toggleMobileDrawer()" class="p-1 rounded-lg text-slate-400 hover:bg-slate-100">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <nav class="mt-4 space-y-2">
        <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold <%= activePage === 'dashboard' ? 'bg-blue-50 text-blue-700' : 'text-slate-700 hover:bg-slate-50' %>">
          <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Dashboard
        </a>
        <a href="/members" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold <%= activePage === 'members' ? 'bg-emerald-50 text-emerald-800' : 'text-slate-700 hover:bg-slate-50' %>">
          <i data-lucide="users" class="w-5 h-5"></i> Members
        </a>
        <a href="/plans" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold <%= activePage === 'plans' ? 'bg-purple-50 text-purple-800' : 'text-slate-700 hover:bg-slate-50' %>">
          <i data-lucide="credit-card" class="w-5 h-5"></i> Membership Plans
        </a>
        <a href="/billing" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold <%= activePage === 'billing' ? 'bg-rose-50 text-rose-800' : 'text-slate-700 hover:bg-slate-50' %>">
          <i data-lucide="receipt" class="w-5 h-5"></i> Billing
        </a>
        <a href="/settings" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold <%= activePage === 'settings' ? 'bg-indigo-50 text-indigo-800' : 'text-slate-700 hover:bg-slate-50' %>">
          <i data-lucide="settings" class="w-5 h-5"></i> Settings
        </a>
      </nav>
    </div>

    <div class="pt-4 border-t border-slate-100">
      <button onclick="api.logout()" class="w-full py-2.5 px-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-bold flex items-center justify-center gap-2">
        <i data-lucide="log-out" class="w-4 h-4"></i> Logout
      </button>
    </div>
  </div>
</div>
