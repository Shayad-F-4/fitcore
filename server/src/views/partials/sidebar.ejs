<aside id="app-sidebar" class="w-64 bg-slate-50/90 border-r border-slate-200/70 hidden lg:flex flex-col h-screen shrink-0 sticky top-0 z-30 select-none">
  <!-- Brand Header -->
  <div class="h-16 sm:h-20 px-4 border-b border-slate-200/70 flex items-center justify-center relative shrink-0 bg-white">
    <a href="/" class="flex items-center justify-center group py-1">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img
          src="/logo.png"
          alt="Sagar Fitness Gym"
          class="h-11 sm:h-13 w-auto max-w-[210px] object-contain transition-transform duration-200 group-hover:scale-105"
          width="210"
          height="52"
        />
      </picture>
    </a>
  </div>

  <!-- Active Role Indicator Card -->
  <div class="mx-3.5 my-2.5 p-3.5 bg-white rounded-xl border border-slate-200 shadow-2xs">
    <div class="flex items-center justify-between">
      <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
        Workspace
      </span>
      <span id="sidebar-role-badge" class="text-[11px] font-bold px-2.5 py-0.5 rounded-full shadow-2xs bg-blue-50 text-blue-700 border border-blue-200">
        👑 Gym Owner
      </span>
    </div>
    <div id="sidebar-role-desc" class="text-[11px] text-slate-600 font-medium mt-1 truncate">
      Full System & Revenue Access
    </div>
  </div>

  <!-- Navigation Links with Exact Card-Style Accents -->
  <nav class="flex-1 p-3.5 pt-1 space-y-1.5 overflow-y-auto">
    <!-- Dashboard -->
    <a
      href="/"
      class="group flex items-center justify-between px-3 py-2.5 min-h-[44px] rounded-xl text-sm transition-all active:scale-[0.98] <%= activePage === 'dashboard' ? 'border-l-4 border-l-blue-500 bg-blue-50/80 text-blue-700 font-bold shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 font-medium border-l-4 border-l-transparent' %>"
    >
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg flex items-center justify-center shrink-0 transition-colors <%= activePage === 'dashboard' ? 'bg-blue-100 text-blue-600' : 'text-slate-400 group-hover:text-slate-600' %>">
          <i data-lucide="layout-dashboard" class="w-4 h-4 shrink-0"></i>
        </div>
        <span>Dashboard</span>
      </div>
      <% if (activePage === 'dashboard') { %>
        <span class="w-1.5 h-1.5 rounded-full bg-blue-600 shrink-0"></span>
      <% } %>
    </a>

    <!-- Members -->
    <a
      href="/members"
      class="group flex items-center justify-between px-3 py-2.5 min-h-[44px] rounded-xl text-sm transition-all active:scale-[0.98] <%= activePage === 'members' ? 'border-l-4 border-l-emerald-500 bg-emerald-50/80 text-emerald-800 font-bold shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 font-medium border-l-4 border-l-transparent' %>"
    >
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg flex items-center justify-center shrink-0 transition-colors <%= activePage === 'members' ? 'bg-emerald-100 text-emerald-600' : 'text-slate-400 group-hover:text-slate-600' %>">
          <i data-lucide="users" class="w-4 h-4 shrink-0"></i>
        </div>
        <span>Members</span>
      </div>
      <% if (activePage === 'members') { %>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 shrink-0"></span>
      <% } %>
    </a>

    <!-- Membership Plans -->
    <a
      href="/plans"
      id="nav-plans"
      class="group flex items-center justify-between px-3 py-2.5 min-h-[44px] rounded-xl text-sm transition-all active:scale-[0.98] <%= activePage === 'plans' ? 'border-l-4 border-l-purple-500 bg-purple-50/80 text-purple-800 font-bold shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 font-medium border-l-4 border-l-transparent' %>"
    >
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg flex items-center justify-center shrink-0 transition-colors <%= activePage === 'plans' ? 'bg-purple-100 text-purple-600' : 'text-slate-400 group-hover:text-slate-600' %>">
          <i data-lucide="credit-card" class="w-4 h-4 shrink-0"></i>
        </div>
        <span>Membership Plans</span>
      </div>
      <% if (activePage === 'plans') { %>
        <span class="w-1.5 h-1.5 rounded-full bg-purple-600 shrink-0"></span>
      <% } %>
    </a>

    <!-- Billing -->
    <a
      href="/billing"
      class="group flex items-center justify-between px-3 py-2.5 min-h-[44px] rounded-xl text-sm transition-all active:scale-[0.98] <%= activePage === 'billing' ? 'border-l-4 border-l-rose-500 bg-rose-50/80 text-rose-800 font-bold shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 font-medium border-l-4 border-l-transparent' %>"
    >
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg flex items-center justify-center shrink-0 transition-colors <%= activePage === 'billing' ? 'bg-rose-100 text-rose-600' : 'text-slate-400 group-hover:text-slate-600' %>">
          <i data-lucide="receipt" class="w-4 h-4 shrink-0"></i>
        </div>
        <span>Billing & Fees</span>
      </div>
      <% if (activePage === 'billing') { %>
        <span class="w-1.5 h-1.5 rounded-full bg-rose-600 shrink-0"></span>
      <% } %>
    </a>

    <!-- Settings -->
    <a
      href="/settings"
      id="nav-settings"
      class="group flex items-center justify-between px-3 py-2.5 min-h-[44px] rounded-xl text-sm transition-all active:scale-[0.98] <%= activePage === 'settings' ? 'border-l-4 border-l-indigo-500 bg-indigo-50/80 text-indigo-800 font-bold shadow-2xs' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 font-medium border-l-4 border-l-transparent' %>"
    >
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg flex items-center justify-center shrink-0 transition-colors <%= activePage === 'settings' ? 'bg-indigo-100 text-indigo-600' : 'text-slate-400 group-hover:text-slate-600' %>">
          <i data-lucide="settings" class="w-4 h-4 shrink-0"></i>
        </div>
        <span>Settings</span>
      </div>
      <% if (activePage === 'settings') { %>
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-600 shrink-0"></span>
      <% } %>
    </a>
  </nav>

  <!-- Bottom Brand & Staff Card -->
  <div class="p-3 border-t border-slate-200/70 bg-slate-50/40 shrink-0">
    <div class="p-3 bg-white rounded-xl border border-slate-200 shadow-xs mb-2">
      <div class="flex items-center gap-2.5">
        <div class="w-7.5 h-7.5 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0 border border-emerald-200 shadow-2xs">
          <i data-lucide="dumbbell" class="w-4 h-4"></i>
        </div>
        <div class="min-w-0 flex-1">
          <span class="truncate font-black text-slate-900 text-xs block">
            Sagar Fitness Gym
          </span>
          <p class="text-[10px] text-slate-500 font-medium truncate mt-0.5">
            Pathardi, Maharashtra
          </p>
        </div>
      </div>
    </div>

    <!-- User / Logout Row -->
    <div class="flex items-center justify-between px-1">
      <div class="flex items-center gap-2 min-w-0">
        <div class="w-7 h-7 rounded-full bg-blue-100 text-blue-700 font-bold text-xs flex items-center justify-center" id="sidebar-user-avatar">
          AD
        </div>
        <div class="truncate text-xs font-bold text-slate-800" id="sidebar-user-name">
          Administrator
        </div>
      </div>
      <button onclick="api.logout()" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg transition-colors cursor-pointer" title="Logout">
        <i data-lucide="log-out" class="w-4 h-4"></i>
      </button>
    </div>
  </div>
</aside>
