# ==============================================================================
# SAGAR FITNESS GYM - SERVER ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Instructions: Copy this file to '.env' and populate with your production values.
# NEVER commit the actual '.env' file to source control.

# Application Environment ('development' or 'production')
NODE_ENV=production

# HTTP Port for Node/Express API Server
PORT=5000

# MongoDB Production Connection String
# Example local: mongodb://127.0.0.1:27017/sagar_fitness
# Example Atlas: mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/sagar_fitness?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_HOST>/sagar_fitness?retryWrites=true&w=majority

# JWT Token Secret (Must be a cryptographically secure string of at least 32 characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_cryptographically_secure_random_64_character_secret_key_here

# JWT Expiration Duration
JWT_EXPIRES_IN=7d

# Frontend Client Origin for Strict Production CORS Validation
# Example: https://gym.sagarfitness.com
CLIENT_URL=http://localhost:5173

# Real Gmail / Transactional SMTP Email Delivery (for 6-Digit Password Reset OTPs & Staff Welcome)
# To use Gmail:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gym_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
EMAIL_FROM="Sagar Fitness Gym" <your_gym_email@gmail.com>

# Optional: Custom Gym Owner / Admin Provisioning (Created on first startup if provided)
INITIAL_ADMIN_EMAIL=owner@sagarfitness.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password
INITIAL_ADMIN_NAME="Sagar Fitness Owner"

# Optional: Meta WhatsApp Cloud API (for automated expiry reminders)
# WHATSAPP_API_TOKEN=your_meta_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
