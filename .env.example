# ==============================================================================
# SAGAR FITNESS GYM MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions: Copy this file to '.env' and fill in your actual production values.
# NEVER commit real credentials, database strings, or API secrets to version control.

# Server Environment Mode ('development' | 'production')
NODE_ENV=production

# API Server Port
PORT=5000

# MongoDB Database Connection URL
# Local: mongodb://127.0.0.1:27017/sagar_fitness
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sagar_fitness?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_HOST>/sagar_fitness?retryWrites=true&w=majority

# JWT Signing Secret (Minimum 32 random characters required in production)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_of_at_least_32_chars

# JWT Session Lifespan
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin for CORS Security
# In production, set to your deployed frontend domain (e.g. https://gym.sagarfitness.com)
CLIENT_URL=http://localhost:5173

# Frontend API Base URL (Used by Vite client during production build if not using reverse proxy)
# VITE_API_URL=https://api.sagarfitness.com/api
