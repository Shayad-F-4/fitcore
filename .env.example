# ==========================================
# FitCore Environment Configuration
# ==========================================

# Server Settings
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB)
# Local instance default:
MONGODB_URI=mongodb://127.0.0.1:27017/fitcore
# Remote Atlas instance example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fitcore?retryWrites=true&w=majority

# Security & JWT Tokens
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_production
JWT_EXPIRES_IN=7d

# Client Application URL (CORS)
CLIENT_URL=http://localhost:5173

# Optional Third-Party Services (Placeholder credentials)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
